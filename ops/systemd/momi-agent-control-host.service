[Unit]
Description=Symphony agent-control Codex host adapter
After=network-online.target momi-agent-control-review-app-server.service
Wants=network-online.target
Requires=momi-agent-control-review-app-server.service

[Service]
Type=simple
User=momi-agent-control
Group=momi-agent-control
SupplementaryGroups=momi-agent-review
WorkingDirectory=/opt/momi-symphony/current
EnvironmentFile=/etc/momi-agent-control/host.env
LoadCredential=momi-review-ledger-key:/etc/momi-agent-control/review-ledger-key
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/momi-symphony/current/services/agent-control-host/main.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=momi-agent-control
StateDirectoryMode=0700
UMask=0007

[Install]
WantedBy=default.target
