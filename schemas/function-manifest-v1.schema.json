{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momi.local/schemas/function-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "function_key", "contract_version", "purpose", "owner_service",
    "function_type", "capability", "boundary", "runtime", "route_path",
    "authentication_policy_key", "entrypoint", "input_schema",
    "output_schema", "required_capabilities", "declared_side_effects"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "function_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.]+\\.v[0-9]+$" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 20 },
    "owner_service": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "function_type": { "enum": ["ingest", "primitive_source", "read", "action", "coordinator"] },
    "capability": { "enum": ["ingest", "hydrate", "read", "decide", "deliver"] },
    "boundary": { "enum": ["toast_inbound", "toast_outbound", "trello_inbound", "trello_outbound", "linear_inbound", "openai_inbound", "momi_internal", "momi_public", "slack_outbound"] },
    "runtime": { "const": "supabase_edge" },
    "route_path": { "type": "string", "pattern": "^/functions/v1/[a-z0-9-]+-v[0-9]+$" },
    "authentication_policy_key": { "type": "string", "minLength": 1 },
    "entrypoint": { "const": "index.ts" },
    "input_schema": { "type": "string", "pattern": "^contracts/.+\\.schema\\.json$" },
    "output_schema": { "type": "string", "pattern": "^contracts/.+\\.schema\\.json$" },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "acceptable_statuses"],
      "properties": {
        "method": { "enum": ["GET", "OPTIONS"] },
        "acceptable_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        }
      }
    },
    "timeout_policy_key": { "type": "string", "minLength": 1 },
    "retry_policy_key": { "type": "string", "minLength": 1 },
    "idempotency_policy_key": { "type": "string", "minLength": 1 },
    "required_capabilities": { "$ref": "#/$defs/string_set" },
    "declared_side_effects": { "$ref": "#/$defs/string_set" }
  },
  "$defs": {
    "string_set": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    }
  }
}
