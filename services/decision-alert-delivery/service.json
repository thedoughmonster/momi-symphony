{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "decision-alert-delivery",
  "purpose": "Deliver bounded, deduplicated material-decision alerts to one governed Slack destination.",
  "kind": "destination_adapter",
  "service_type": "destination_adapter",
  "lifecycle_status": "active",
  "functions": ["momi-decision-alert-delivery-v1"],
  "contracts": {
    "provides": ["momi.slack.decision_alert.deliver.v1"],
    "consumes": [
      {"service": "agent-control", "contract": "momi.agent_control.decision_alert_work.v1"}
    ]
  },
  "database": {"read": ["momi_agent_ops"], "write": ["momi_agent_ops"]},
  "network": {"outbound_hosts": ["slack.com"]},
  "secrets": ["SUPABASE_DB_URL", "SLACK_BOT_TOKEN"],
  "configuration": [],
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": []
}
