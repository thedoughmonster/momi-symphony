{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "work_id", "capability_token", "issue_id", "issue_identifier", "issue_url", "project_id", "project_name", "repository", "base_branch", "active_states", "interaction_mode", "thread_name", "stable_instruction", "volatile_context", "stable_prefix_fingerprint", "context_fingerprint", "policy_version", "budget"],
  "properties": {
    "schema_version": {"const": 3},
    "work_id": {"type": "string", "format": "uuid"},
    "capability_token": {"type": "string", "format": "uuid"},
    "issue_id": {"type": "string", "format": "uuid"},
    "issue_identifier": {"type": "string"},
    "issue_url": {"type": "string", "format": "uri"},
    "project_id": {"type": "string", "format": "uuid"},
    "project_name": {"type": "string"},
    "repository": {"type": "string"},
    "base_branch": {"type": "string"},
    "active_states": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}},
    "interaction_mode": {"enum": ["one_shot", "interactive"]},
    "thread_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "stable_instruction": {"type": "string", "minLength": 40, "maxLength": 8000},
    "volatile_context": {"type": "string", "minLength": 40, "maxLength": 8000},
    "stable_prefix_fingerprint": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"},
    "context_fingerprint": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "budget": {
      "type": "object",
      "required": ["model_turns", "no_progress_cycles", "subagents", "subagent_depth", "model_visible_tool_bytes", "elapsed_ms"],
      "properties": {
        "model_turns": {"type": "integer", "minimum": 0},
        "no_progress_cycles": {"type": "integer", "minimum": 0},
        "subagents": {"type": "integer", "minimum": 0},
        "subagent_depth": {"type": "integer", "minimum": 0},
        "model_visible_tool_bytes": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
