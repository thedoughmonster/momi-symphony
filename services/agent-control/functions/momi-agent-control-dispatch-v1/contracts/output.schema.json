{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": {"type": "boolean"},
    "disposition": {
      "enum": [
        "active", "completed", "interrupted", "duplicate", "rejected", "retrying",
        "queued_cancelled", "requested", "already_terminal", "recovered",
        "already_archived", "no_target", "ambiguous_target", "mapping_mismatch",
        "operator_intervention", "recorded", "created", "pending", "accepted",
        "changes_requested", "inconclusive", "failed", "implementation_identity_refused",
        "current_dispatch_refused", "focused_validation_required", "already_accepted",
        "already_pending", "pending_subject_conflict", "parent_attempt_refused",
        "parent_reviewer_refused", "capacity_wait", "normal_review"
      ]
    },
    "thread_id": {"type": "string"},
    "review": {"type": "object"},
    "review_attempt_id": {"type": ["string", "null"], "format": "uuid"},
    "parent_attempt_id": {"type": ["string", "null"], "format": "uuid"},
    "reviewer_dispatch_id": {"type": ["string", "null"], "format": "uuid"},
    "reviewer_thread_id": {"type": ["string", "null"]},
    "state": {"enum": ["pending", "accepted", "changes_requested", "failed", "canceled"]},
    "findings": {"type": "array", "maxItems": 100},
    "failure_reason": {"type": ["string", "null"]},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "profile": {"enum": ["low", "standard", "high"]},
    "review_required": {"type": "boolean"},
    "review_escalated": {"type": "boolean"},
    "risk_triggers": {"type": "array", "uniqueItems": true, "items": {"enum": [
      "security_privacy", "destructive_migration", "public_contract",
      "production_exposure_cost", "concurrency_state_integrity",
      "explicit_owner_request"
    ]}},
    "policy_version": {"type": "string"},
    "eligible": {"type": "boolean"},
    "merged": {"type": "boolean"},
    "reason": {"type": "string"},
    "routes": {"type": "integer", "minimum": 0},
    "observed": {"type": "integer", "minimum": 0},
    "claimed": {"type": "integer", "minimum": 0},
    "technical_retries": {"type": "integer", "minimum": 0},
    "projection_retries": {"type": "integer", "minimum": 0},
    "projection_failures": {"type": "integer", "minimum": 0},
    "quarantines_created": {"type": "integer", "minimum": 0},
    "quarantine_capacity_released": {"type": "integer", "minimum": 0},
    "active_quarantines": {"type": "integer", "minimum": 0},
    "oldest_quarantine_age_seconds": {"type": "integer", "minimum": 0},
    "manual_interventions": {"type": "integer", "minimum": 0},
    "requested": {"type": "integer", "minimum": 0},
    "succeeded": {"type": "integer", "minimum": 0},
    "retryable": {"type": "integer", "minimum": 0},
    "skipped": {"type": "integer", "minimum": 0},
    "execution_status": {
      "enum": ["pending", "running", "succeeded", "failed", "interrupted"]
    },
    "projection_status": {
      "enum": ["pending", "in_progress", "retryable", "failed", "succeeded",
        "superseded", "skipped"]
    }
  },
  "additionalProperties": false
}
