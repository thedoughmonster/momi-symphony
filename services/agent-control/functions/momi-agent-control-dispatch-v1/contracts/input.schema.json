{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": ["work_id", "capability_token"],
      "properties": {
        "work_id": {"type": "string", "format": "uuid"},
        "capability_token": {"type": "string", "format": "uuid"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["event", "work_id", "capability_token", "thread_id", "turn_id", "readiness_result", "terminal_disposition", "archived_at"],
      "properties": {
        "event": {"const": "terminal"},
        "work_id": {"type": "string", "format": "uuid"},
        "capability_token": {"type": "string", "format": "uuid"},
        "thread_id": {"type": "string"},
        "turn_id": {"type": "string"},
        "readiness_result": {"enum": ["ready", "unready", "failed"]},
        "terminal_disposition": {"enum": ["completed", "failed", "interrupted"]},
        "archived_at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "maxLength": 1000}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["event", "scheduler_id", "release_sha", "active_work_ids"],
      "properties": {
        "event": {"const": "scheduler_pump"},
        "scheduler_id": {"type": "string", "format": "uuid"},
        "release_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "active_work_ids": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        }
      },
      "additionalProperties": false
    }
  ]
}
