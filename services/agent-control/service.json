{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "agent-control",
  "purpose": "Own durable Linear action dispatch, Codex task delivery, write-back, and archival state.",
  "kind": "core_capability",
  "service_type": "dataset_owner",
  "lifecycle_status": "active",
  "functions": [
    "momi-agent-control-dispatch-v1",
    "momi-agent-control-linear-webhook-v1"
  ],
  "contracts": {
    "provides": [
      "momi.agent_control.dispatch.v1",
      "momi.agent_control.decision_alert_work.v1",
      "momi.agent_control.linear_webhook.v1",
      "momi.agent_control.independent_review.v1",
      "momi.agent_control.merge_request.v1",
      "momi.agent_control.scheduler_pump.v1"
    ],
    "consumes": [
      {"service": "agent-control-host", "contract": "momi.agent_control.host_dispatch.v2"},
      {"service": "agent-control-host", "contract": "momi.agent_control.host_review_dispatch.v1"},
      {"service": "agent-control-host", "contract": "momi.agent_control.host_cancel.v2"},
      {"service": "agent-control-host", "contract": "momi.agent_control.host_recover.v1"}
    ]
  },
  "database": {
    "read": ["momi_agent_ops"],
    "write": ["momi_agent_ops"]
  },
  "network": {
    "outbound_hosts": [
      "api.linear.app",
      "api.github.com",
      "configured:codex_host_adapter_url",
      "configured:supabase_project_url"
    ]
  },
  "secrets": [
    "SUPABASE_DB_URL",
    "LINEAR_WEBHOOK_SECRET",
    "LINEAER_ACCESS",
    "LINEAR_API_KEY",
    "MOMI_CODEX_HOST_SECRET",
    "MOMI_GITHUB_REVIEW_TOKEN",
    "MOMI_GITHUB_REVIEW_PUBLISHER",
    "MOMI_GITHUB_REVIEW_APP_ID"
  ],
  "configuration": [],
  "deployment": {
    "owns": [
      {"kind": "cron_job", "key": "momi-agent-control-dispatch-recovery-v1"}
    ],
    "depends_on": [
      {"kind": "postgres_extension", "key": "pg_cron"},
      {"kind": "postgres_extension", "key": "pg_net"},
      {"kind": "vault_secret", "key": "momi_project_url"},
      {"kind": "vault_secret", "key": "momi_publishable_key"}
    ]
  },
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": [],
  "owned_dataset": {
    "dataset_key": "momi.agent_control",
    "dataset_class": "operational",
    "db_role": "svc_agent_control",
    "private_schema": "momi_agent_ops",
    "private_relations": [
      "momi_agent_ops.dispatches",
      "momi_agent_ops.decision_alert_policies",
      "momi_agent_ops.decision_alerts",
      "momi_agent_ops.decision_delivery_work",
      "momi_agent_ops.decision_delivery_attempts",
      "momi_agent_ops.project_mappings",
